# Server
PORT=8000
NODE_ENV=production
# Public site address (used in emails, QR codes and CORS)
FRONTEND_URL=https://your-domain.cm
# Public address of this API (QR images inside emails). Example: https://api.your-domain.cm
API_PUBLIC_URL=
# Extra allowed browser origins, comma separated (defaults to FRONTEND_URL)
CORS_ORIGINS=

# Database
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# Set to true when the database requires SSL
PG_SSL=false

# Security (use a long random value, at least 32 characters)
JWT_SECRET=

# Redis (optional: seat holds and email queue). Plain URL, e.g. rediss://default:password@host:6379
REDIS_URL=

# Payments (Campay)
CAMPAY_APP_PERMANENT_ACCESS_TOKEN=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
# Defaults to https://www.campay.net/api (use https://demo.campay.net/api for testing)
CAMPAY_BASE_URL=
# Mobile Money number that receives the platform service fee
DEVELOPER_MOMO_NUMBER=

# Email (Brevo)
BREVO_API_KEY=
SENDER_NAME=
SENDER_EMAIL=
SUPPORT_EMAIL=
